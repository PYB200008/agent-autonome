# Riot API
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_REGION=euw1

# Discord
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=000000000000000000

# Comptes suivis (PUUIDs, séparés par des virgules)
# Résolvez les Riot IDs via l'API Account-V1 d'abord
TRACKED_PUUIDS=puuid1,puuid2

# Poll interval (secondes)
WATCHER_INTERVAL=60
