# Riot API
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_REGION=euw1

# Discord webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/XXXX

# Comptes suivis (PUUIDs, s\u00e9par\u00e9s par des virgules)
# R\u00e9solvez les Riot IDs via l'API Account-V1 d'abord
TRACKED_PUUIDS=puuid1,puuid2

# Poll interval (secondes)
WATCHER_INTERVAL=60
