# Copier ce fichier en .env et remplir les valeurs.
# Ce fichier est committé ; .env ne l'est jamais.

# Discord — token du bot (Developer Portal > Bot > Token)
DISCORD_TOKEN=

# ID numérique de l'utilisateur autorisé en DM (scotobi)
DISCORD_USER_ID=

# API Groq — clé gratuite à créer sur https://console.groq.com/
GROQ_API_KEY=

# Identité git utilisée pour les commits
GIT_NAME=William Bellon
GIT_EMAIL=william.bellon@supdevinci-edu.fr

# Token git pour le push (HTTPS)
GIT_TOKEN=
